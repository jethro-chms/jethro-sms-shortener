# SMS shortener — environment configuration
# Copy this to .env:  cp .env.example .env
#
# .env is gitignored — never commit real credentials.

# Base URL of the deployed worker (no trailing slash); 'jethroau' = https://jethro.au
SMSSHORTENER="jethroau"

# API key for the PHP client: any jethro.au URL shortener key (admin or create),
# or the worker's bootstrap API_KEY secret (cf workers secrets update API_KEY).
SMSSHORTENER_API_KEY="cus_..."
