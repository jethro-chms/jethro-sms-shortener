# Composer installs from the GitHub archive: ship only the PHP client, the
# licence and the docs; the Cloudflare worker and tooling stay out of
# downstream vendor/ trees.
/.gitattributes      export-ignore
/.gitignore          export-ignore
/.env.example        export-ignore
/cloudflare.config.example.ts export-ignore
/devbox.json         export-ignore
/devbox.lock         export-ignore
/package.json        export-ignore
/pnpm-lock.yaml      export-ignore
/pnpm-workspace.yaml export-ignore
/vite.config.ts      export-ignore
/worker.js           export-ignore
/test_worker.js      export-ignore
/privacy.js          export-ignore
